{
  // Visit https://aka.ms/tsconfig to read more about this file
  "compilerOptions": {
    "target": "es6",
    "module": "commonjs",
    "outDir": "./js",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true
  },

"include": ["src/**/*"],
"exclude": [
  "node_modules",
  "**/*.spec.ts",
  "css",
  "images",
  "**/*.test.ts"
]

}